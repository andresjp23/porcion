# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase start` (API URL and anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Contact for the Open Food Facts User-Agent: "Porcion/0.1 (<contact>)"
VITE_OFF_USER_AGENT=Porcion/0.1 (contacto@ejemplo.cl)

# Google OAuth (A-1). Read by supabase/config.toml, not by the app, so no VITE_ prefix.
# Google Cloud Console → OAuth client (Web), redirect URI http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
