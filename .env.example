# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase start` (API URL and anon key).
# Or /supabase to go through the dev server's proxy (phone through ngrok).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Contact for the Open Food Facts User-Agent: "Porcion/0.1 (<contact>)"
VITE_OFF_USER_AGENT=Porcion/0.1 (contacto@ejemplo.cl)

# Google OAuth (A-1). Read by supabase/config.toml, not by the app, so no VITE_ prefix.
# Google Cloud Console → OAuth client (Web), redirect URI http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Where Google returns after sign-in. Keep this value on the computer; for the
# phone use https://<dominio ngrok>/supabase/auth/v1/callback (CLAUDE.md,
# "Probar en el teléfono"). Must not be empty: the CLI would pass "env(...)" as is.
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback
